# Copy to .env.local for local development, and set the same names in
# Vercel → Project Settings → Environment Variables for production.

# Password for /admin and /admin/blog. Required: without it nobody can log in.
ADMIN_PASSWORD=

# Optional: Resend API key so contact-form leads arrive by e-mail.
RESEND_API_KEY=
# Optional: where lead e-mails go (defaults to info@bridgecare.co).
CONTACT_TO_EMAIL=
